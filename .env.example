# Copy to .env.local and fill in. Never commit real values.

# Anthropic API key (server-side only; never exposed to the browser).
ANTHROPIC_API_KEY=sk-ant-...

# Supabase read path. Publishable/anon key: read-only under RLS, safe to deploy.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase write path. Service-role key bypasses RLS - keep this local, and do
# not set it in any hosting platform's environment.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Direct Postgres connection, only for `npm run db:migrate`.
# Optional: you can paste the migration into the Supabase SQL editor instead.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres

# Shared secret guarding POST /api/triage (live re-triage). Leave unset in any
# public deployment so the hosted app physically cannot call the paid API.
TRIAGE_ADMIN_TOKEN=

# Alternative route to the same model, OpenAI-compatible protocol. Either this
# or ANTHROPIC_API_KEY is required; set both and pin LLM_PROVIDER to choose.
OPENROUTER_API_KEY=sk-or-v1-...

# 'anthropic' | 'openrouter'. Auto-detects when unset (prefers Anthropic).
LLM_PROVIDER=
