# ---------------------------------------------------------------------------
# TWO FILES, ON PURPOSE. This split is a deployment-safety boundary.
# ---------------------------------------------------------------------------
#
# @opennextjs/cloudflare serialises every variable Next.js loads into
# .open-next/cloudflare/next-env.mjs, which ships INSIDE the deployed Worker.
# Next.js auto-loads `.env.local`, so anything placed there is published to the
# public URL -- whether or not it is prefixed NEXT_PUBLIC_.
#
# During development this silently baked a live Anthropic key, an OpenRouter key,
# the Supabase service-role key and the admin token into the build artifact.
# `npm run check:bundle` now fails the build if that ever recurs.
#
#   .env.local    -> safe to publish. Next.js loads it; the Worker contains it.
#   .env.secrets  -> secret. Next.js does not know the filename, so it is never
#                    bundled. Loaded only by lib/load-env.ts (local scripts).
# ---------------------------------------------------------------------------

# =========================== .env.local ===================================
# Read path only. The publishable/anon key is read-only under RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...   # or sb_publishable_...

# =========================== .env.secrets =================================
# Never set any of these in a hosting platform for this app.

# One LLM credential is required. Both work; LLM_PROVIDER picks when both exist.
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-v1-...
LLM_PROVIDER=            # 'anthropic' | 'openrouter'. Auto-detects when unset.

# Supabase write path. Bypasses RLS -- local scripts only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: only for `npm run db:migrate` over a direct Postgres connection.
# Not needed if you use `supabase db query --linked` or the SQL editor.
DATABASE_URL=

# Guards POST /api/triage. Leave unset in any public deployment so the hosted
# app is structurally unable to call a paid API.
TRIAGE_ADMIN_TOKEN=
